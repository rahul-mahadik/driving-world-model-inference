{
  "schema_version": 1,
  "suite_id": "operator-generalization-v2",
  "description": "Constructed shape-family generalization benchmark for two fixed operator implementations and their launch configurations. The specification itself contains no measured outcomes.",
  "provenance": "GEGLU and GroupNorm32-SiLU are related to Vista inference. Shapes here are constructed, not recorded activations, a representative model trace, or held-out operator families.",
  "split_policy": "Group by (operator, exact input shape), then assign each family to one split before measurements. All dtypes and seeds of a shape stay together; changing GroupNorm group count cannot move a shape across splits. Both operator families occur in all splits.",
  "input_policy": "Seeded standard-normal tensors and seeded float32 affine weights/bias; the same family seed is used across dtypes. These are open task specifications, not secret test inputs or licensed driving data.",
  "timing_boundary": "Single isolated operator invocation, CUDA events; initialization, compilation, input creation, warmups, correctness and export excluded but charged to wall time.",
  "memory_boundary": "Peak live allocated increase above resident inputs, including output; not full-model memory or allocator reservation.",
  "quality_policy": "Reference-output shape/dtype/finiteness, dtype-specific allclose, and input immutability. Fixed rtol/atol: float16 0.002/0.002; bfloat16 0.02/0.02; float32 0.00002/0.000003. No video perceptual-quality claim.",
  "quality_tolerances": {
    "float16": {
      "rtol": 0.002,
      "atol": 0.002
    },
    "bfloat16": {
      "rtol": 0.02,
      "atol": 0.02
    },
    "float32": {
      "rtol": 2e-05,
      "atol": 3e-06
    }
  },
  "candidate_policy": "One torch.compile/Inductor control plus the Cartesian product of supported Triton block sizes 64..2048 and 1/2/4/8 warps. All configurations are attempted for every task; compilation, resource and numerical failures remain recorded outcomes, not substituted results.",
  "resource_design": {
    "maximum_input_tensor_bytes": 251658240,
    "input_tensor_cap_bytes": 268435456,
    "intended_minimum_gpu_memory_gib": 24,
    "maximum_group_chunks_at_block64": 1440,
    "scope": "Analytical input-size and kernel chunk bounds only. Runtime, compiler and allocator overhead are additional; fitting or completing on any GPU is not asserted."
  },
  "default_trial_budget": 8,
  "default_memory_weight": 0.0,
